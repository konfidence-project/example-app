{
  "name": "@konfidence/next-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js deployment adapter that turns one `next build` into Konfidence artifacts: a Helm-deployed Node server and an S3-deployed static bundle.",
  "license": "Apache-2.0",
  "bin": {
    "konfidence-next": "./dist/cli.js"
  },
  "files": [
    "dist",
    "charts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    },
    "./devtools/route": {
      "types": "./dist/devtools/route.d.ts",
      "default": "./dist/devtools/route.js"
    }
  },
  "scripts": {
    "build": "node ./node_modules/typescript-native/bin/tsc -p ./tsconfig.build.json",
    "prepare": "pnpm build",
    "check": "node ./node_modules/typescript-native/bin/tsc -p ./tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "verify": "pnpm check && pnpm lint && pnpm fmt:check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "next": ">=16.2.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
