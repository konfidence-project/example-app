{
  "name": "@konfidence/next-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js deployment adapter that turns one `next build` into Konfidence artifacts: a Helm-deployed Node server and an S3-deployed static bundle.",
  "license": "Apache-2.0",
  "bin": {
    "konfidence-next": "./bin/konfidence-next.js"
  },
  "files": [
    "src",
    "bin",
    "charts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/adapter.js",
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "next": ">=16.2.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
