{
  "name": "candidates-run-schema-migration",
  "type": "k8s-job",
  "dependsOn": [
    "candidates-verify-db-ready"
  ],
  "spec": {
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "run-migration",
            "image": "${REGISTRY}/candidates-migrations:${VERSION}",
            "envFrom": [
              {
                "secretRef": {
                  "name": "example-app-db-credentials"
                }
              }
            ],
            "command": [
              "/bin/sh",
              "-c"
            ],
            "args": [
              "echo \"deliberate migration failure\" >&2; exit 1"
            ]
          }
        ]
      }
    },
    "backoffLimit": 0,
    "activeDeadlineSeconds": 60
  }
}
