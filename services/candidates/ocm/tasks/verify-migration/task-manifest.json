{
  "name": "candidates-verify-migration",
  "type": "k8s-job",
  "dependsOn": ["candidates-run-schema-migration"],
  "spec": {
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "verify-migration",
            "image": "${REGISTRY}/candidates-migrations:v0.1.0",
            "envFrom": [{ "secretRef": { "name": "example-app-db-credentials" } }],
            "command": ["/bin/sh", "-c"],
            "args": [
              "migrate -path=/migrations -database \"postgres://$PGUSER:$PGPASSWORD@$PGHOST:$PGPORT/$PGDATABASE?sslmode=${PGSSLMODE:-disable}&x-migrations-table=schema_migrations_candidates\" version"
            ]
          }
        ]
      }
    },
    "backoffLimit": 4
  }
}
