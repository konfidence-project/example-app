{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Konfidence example app: web frontend (Next.js)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm check && pnpm lint && pnpm fmt:check"
  },
  "dependencies": {
    "@konfidence/next-devtools": "workspace:*",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
