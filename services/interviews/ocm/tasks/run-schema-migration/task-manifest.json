{
  "name": "interviews-run-schema-migration",
  "type": "k8s-job",
  "dependsOn": ["interviews-verify-db-ready"],
  "spec": {
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "run-migration",
            "image": "${REGISTRY}/interviews-migrations:${VERSION}",
            "envFrom": [{ "secretRef": { "name": "example-app-db-credentials" } }],
            "command": ["/bin/sh", "-c"],
            "args": [
              "migrate -path=/migrations -database \"postgres://$PGUSER:$PGPASSWORD@$PGHOST:$PGPORT/$PGDATABASE?sslmode=${PGSSLMODE:-disable}&x-migrations-table=schema_migrations_interviews\" up"
            ]
          }
        ]
      }
    },
    "backoffLimit": 4
  }
}
