{
  "name": "interviews-verify-db-ready",
  "type": "k8s-job",
  "spec": {
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "verify-db-ready",
            "image": "${REGISTRY}/interviews-migrations:${VERSION}",
            "envFrom": [{ "secretRef": { "name": "example-app-db-credentials" } }],
            "command": ["/bin/sh", "-c"],
            "args": [
              "until pg_isready -h \"$PGHOST\" -p \"$PGPORT\" -U \"$PGUSER\"; do echo waiting for postgres; sleep 2; done"
            ]
          }
        ]
      }
    },
    "backoffLimit": 30
  }
}
